# Copy this file to .env and fill in your own values.
# Never commit .env - it's already in .gitignore.

# Your Anthropic API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# A Home Assistant Long-Lived Access Token:
# https://www.home-assistant.io/docs/authentication/#your-account-profile
HA_TOKEN=your-home-assistant-long-lived-access-token-here

# Base URL of your Home Assistant instance (no trailing slash, and include
# the port only if HA isn't listening on the default port for that scheme).
HA_URL=http://homeassistant.local

# Optional - the battery monitor (see src/personal_assistant/battery_monitor.py)
# auto-discovers a battery sensor and, if present, a matching charging
# sensor on startup and prints what it found. Only set these if it picks
# the wrong one (e.g. more than one phone reports battery to HA) or finds
# none at all.
# BATTERY_ENTITY_ID=sensor.your_phone_battery_level
# BATTERY_CHARGING_ENTITY_ID=binary_sensor.your_phone_battery_charging
