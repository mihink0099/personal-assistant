# Copy this file to .env and fill in your own values.
# Never commit .env - it's already in .gitignore.

# Your Anthropic API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# A Home Assistant Long-Lived Access Token:
# https://www.home-assistant.io/docs/authentication/#your-account-profile
HA_TOKEN=your-home-assistant-long-lived-access-token-here

# Base URL of your Home Assistant instance (no trailing slash, and include
# the port only if HA isn't listening on the default port for that scheme).
HA_URL=http://homeassistant.local
